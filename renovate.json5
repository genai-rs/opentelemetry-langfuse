{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['github>genai-rs/.github:renovate-default'],
  packageRules: [
    {
      description: 'Core dependencies',
      matchPackageNames: ['opentelemetry', 'opentelemetry_sdk', 'opentelemetry-otlp'],
      labels: ['dependencies', 'core'],
      automerge: true,
    },
  ],
}
